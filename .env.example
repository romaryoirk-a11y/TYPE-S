# ===== Настройки подключения Pulse к MongoDB =====
# Скопируйте этот файл в .env и заполните значения.

# Внешняя MongoDB (Atlas или локальный mongod).
# Если переменную НЕ задать — сервер автоматически поднимет встроенную
# in-memory MongoDB (данные исчезнут после перезапуска!).
MONGODB_URI=mongodb+srv://ВАШ_ПОЛЬЗОВАТЕЛЬ:ВАШ_ПАРОЛЬ@cluster0.xxxxx.mongodb.net/pulse?retryWrites=true&w=majority

# Порт сервера (по умолчанию 3000)
PORT=3000

# Ключи Web Push (необязательно, генерируются: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
